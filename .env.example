# ================================
# Application
# ================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# ================================
# Database (MongoDB)
# ================================
MONGO_URI=mongodb://localhost:27017/school_ms
# For MongoDB Atlas (cloud), use something like:
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/school_ms

# ================================
# Authentication
# ================================
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ================================
# CORS (frontend URL)
# ================================
CORS_ORIGIN=http://localhost:5173

# ================================
# Email (later - password reset, notifications)
# ================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=